# ============================================================
# Portfolio · environment variables
# Copy this file to `.env.local` and fill in real values.
# DO NOT commit `.env.local`.
# ============================================================

# --- Contact form mail delivery (Nodemailer / any SMTP provider) ---
# Examples:
#   Gmail (with an App Password, NOT your account password):
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=465
#   SendGrid / Mailgun / Resend SMTP — set their respective values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-account@gmail.com
SMTP_PASSWORD=your-app-password

# Where messages land. The form UI never exposes this address.
CONTACT_TO_EMAIL=rockercandy14@gmail.com
